# PATHWISE AI Backend Configuration (Render / Linux / Production)

# Server Binding (Render automatically manages PORT, e.g. 10000)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated list of allowed frontend domains; .vercel.app is also matched via regex)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,https://pathwise-ai.vercel.app

# Persistent Storage Overrides (Optional - for Render Persistent Disk mounts, e.g. /var/data)
# DATABASE_PATH=/var/data/reports.db
# UPLOADS_DIR=/var/data/uploads
# DATASET_DIR=/var/data/dataset
